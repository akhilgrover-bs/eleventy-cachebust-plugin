{
  "name": "eleventy-cachebust-plugin",
  "version": "1.0.0",
  "description": "Eleventy plugin for CDN cache busting. Supports hash-based and build-time strategies with per-asset-type control.",
  "main": "src/index.js",
  "module": "src/index.mjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/akhilgrover-bs/eleventy-cachebust-plugin.git"
  },
  "homepage": "https://github.com/akhilgrover-bs/eleventy-cachebust-plugin#readme",
  "exports": {
    ".": {
